post_install() {
  printf '%s\n' 'MX Touchpad Gestures installed.' \
    'As your desktop user, run: mxmaster3-gestures-setup' \
    'Configure Solaar: Mouse Gesture Button -> Diverted; restart Solaar.' \
    'Reconnect your mouse or log out/in if input ACLs are not updated.'
}
post_upgrade() {
  printf '%s\n' 'MX Touchpad Gestures upgraded. Restart the user service if it is active:' \
    'systemctl --user restart mxmaster3-gestures.service'
}
post_remove() {
  printf '%s\n' 'Package files removed. Personal Solaar rules are unchanged.'
}
