post_install() {
  printf '%s\n' 'MX Touchpad Gestures installed.'
  printf '%s\n' 'Open MX Touchpad Gestures Settings from GNOME Activities.'
  printf '%s\n' 'First launch configures Solaar and starts the gesture driver automatically.'
  printf '%s\n' 'Reconnect the mouse or log out/in if input permissions need refreshing.'
}
post_upgrade() {
  printf '%s\n' 'MX Touchpad Gestures upgraded. Open Settings to configure gestures.'
  printf '%s\n' 'Restart the gesture service to apply package updates.'
}
post_remove() {
  printf '%s\n' 'Package files removed. Personal Solaar rules and settings are unchanged.'
}
